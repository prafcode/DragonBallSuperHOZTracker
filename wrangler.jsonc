{
  // Cloudflare Workers (static assets only — no server code).
  // "name" must match the project name in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dragonballsuperhoztracker",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Vite's build output.
    "directory": "./dist",
    // Unknown paths like /card/goku/44 or /stats serve index.html so React Router can handle them.
    "not_found_handling": "single-page-application"
  }
}
